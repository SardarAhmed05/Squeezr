# Normalize line endings; keep Windows scripts CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.dll binary
*.sfx binary
*.7z binary
*.zip binary
*.icns binary
*.pfx binary
*.woff binary
*.woff2 binary

# Generated / vendored
package-lock.json linguist-generated=true
resources/engine/** -text linguist-vendored=true
